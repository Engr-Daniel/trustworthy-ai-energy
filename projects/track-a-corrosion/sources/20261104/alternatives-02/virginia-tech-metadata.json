{"files": [{"id": 30914467, "name": "Corrosion Annotation Guidelines.pdf", "size": 1280192, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/30914467", "supplied_md5": "b39d82a30e3c5d6b8303a70543ef4288", "computed_md5": "b39d82a30e3c5d6b8303a70543ef4288", "mimetype": "application/pdf"}, {"id": 30930610, "name": "README_corrosion_dataset.rtf", "size": 3904, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/30930610", "supplied_md5": "48bcf95bde8e985f722ad13b223f5ca7", "computed_md5": "48bcf95bde8e985f722ad13b223f5ca7", "mimetype": "text/rtf"}, {"id": 31729733, "name": "Corrosion Condition State Classification.zip", "size": 333388620, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/31729733", "supplied_md5": "bbc9b8b8a5bb065e9ace028893dfd983", "computed_md5": "bbc9b8b8a5bb065e9ace028893dfd983", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 10608929, "full_name": "Eric Bianchi", "first_name": "Eric", "last_name": "Bianchi", "is_active": false, "url_name": "Eric_Bianchi", "orcid_id": "0000-0001-9003-1414"}, {"id": 11456938, "full_name": "Matthew Hebdon", "first_name": "Matthew", "last_name": "Hebdon", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9115-0279"}], "custom_fields": [{"name": "Publisher", "value": "University Libraries, Virginia Tech", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Publisher"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Location", "value": "Virginia Tech", "settings": {"validations": {"min_length": 1, "max_length": 2500}, "placeholder": "Location"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://data.lib.vt.edu/articles/dataset/Corrosion_Condition_State_Semantic_Segmentation_Dataset/16624663", "download_disabled": false, "description": "<p>The data was collected from the Virginia Department of\nTransportation (VDOT) Bridge Inspection Reports. The data was semantically\nannotated following the corrosion condition state guidelines stated in the\nAmerican Association of State Highway and Transportation Officials (AASHTO) and\nBridge Inspector's Reference Manual (BIRM). There were four corrosion class\ncategories: [good, fair, poor, severe]. The dataset consisted of 440 finely\nannotated images and was randomly split into 396 training images and 44 testing\nimages. The images were resized to 512x512 for training and testing the\nDeeplabV3+ model. The original and resized images are included. After training\nwith the DeeplabV3+ model (DOI: 10.7294/16628668), we were able to receive an\nF1 score of 86.67. More details of the training, the results, the dataset, and\nthe code may be referenced in the journal article. The GitHub repository\ninformation may be found in the journal article.</p><p><br>If you are using the dataset in your work, please include <b>both </b>the journal article and the dataset citation. <br></p>", "funding": "National Science Foundation Grant No. IIS-1840044", "funding_list": [{"id": 21040666, "title": "National Science Foundation Grant No. IIS-1840044", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 2, "status": "public", "size": 334672716, "created_date": "2021-12-13T14:42:21Z", "modified_date": "2023-05-30T16:41:04Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["Structural Engineering", "Bridge Inspection", "Corrosion", "Structural Inspection", "Deep Learning", "Machine Learning", "Semantic Segmentation", "Structural Engineering"], "keywords": ["Structural Engineering", "Bridge Inspection", "Corrosion", "Structural Inspection", "Deep Learning", "Machine Learning", "Semantic Segmentation", "Structural Engineering"], "categories": [{"id